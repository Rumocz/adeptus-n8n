# Copy to .env and fill in. .env is gitignored — never commit real secrets.
#   cp .env.example .env
# Generate secrets:
#   openssl rand -hex 32   # N8N_ENCRYPTION_KEY
#   openssl rand -hex 24   # POSTGRES_PASSWORD

# Pin a version for reproducible deploys (recommended over "latest").
N8N_VERSION=latest

# CRITICAL: encrypts saved credentials. Keep it STABLE and SECRET.
# If this changes or is lost, existing credentials can no longer be decrypted.
# Use the SAME key locally and on the server if you migrate workflows.
N8N_ENCRYPTION_KEY=

# Postgres
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=

GENERIC_TIMEZONE=UTC

# ---- Local (WSL2) values ----
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678
N8N_SECURE_COOKIE=false

# ---- Server values (uncomment / swap in on the remote host) ----
# N8N_HOST=n8n.example.com
# N8N_PROTOCOL=https
# N8N_EDITOR_BASE_URL=https://n8n.example.com
# WEBHOOK_URL=https://n8n.example.com
# N8N_SECURE_COOKIE=true
# N8N_DOMAIN=n8n.example.com      # used by Caddy (docker-compose.prod.yml)
# ACME_EMAIL=you@example.com      # Let's Encrypt notifications
